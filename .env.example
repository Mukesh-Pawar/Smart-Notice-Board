SECRET_KEY=change-this-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# SQLite is the default. For PostgreSQL/MySQL, configure DATABASE_URL
# and extend config/settings.py with the matching database backend.
DATABASE_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@smartnotice.local

SESSION_COOKIE_AGE=1800
API_TOKEN_AUTH_ENABLED=True

# Future GSM integration. Keep these empty until hardware is connected.
GSM_ENABLED=False
GSM_SERIAL_PORT=
GSM_BAUD_RATE=9600
GSM_SIM_NUMBER=
